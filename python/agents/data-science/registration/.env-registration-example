#!/bin/bash

# Gemini Enterprise Agent Registration Configuration
# This file contains environment variables needed to register your agent in Gemini Enterprise

# GCP Project Configuration
# Option 1: Automatically get values from gcloud (uncomment to use)
# export PROJECT_ID=$(gcloud config get-value project)
# export PROJECT_NUMBER=$(gcloud projects describe $(gcloud config get-value project) --format='value(projectNumber)')

# Option 2: Manually set values (recommended for production)
export PROJECT_ID="<YOUR-ID>"  # Your GCP project ID
export PROJECT_NUMBER="<YOUR-ID>"  # Your GCP project number

# Gemini Enterprise App ID
# Find this in your Gemini Enterprise console under Agent Builder > Apps
export APP_ID="<YOUR-ID>"  # ID of your Agentspace app

# Agent Metadata
# These values will be displayed in Gemini Enterprise
export DISPLAY_NAME="Data Science Agent Demo"
export DESCRIPTION="A multi-agent system designed for sophisticated data analysis"
export TOOL_DESCRIPTION="Multiple data science related tools"