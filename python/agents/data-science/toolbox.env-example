# AlloyDB Postgres Configuration
# These environment variables configure the connection to AlloyDB Postgres database
# Replace the placeholder values with your actual AlloyDB instance details

# GCP Project ID where AlloyDB is deployed
ALLOYDB_POSTGRES_PROJECT=<project_id>

# GCP region where AlloyDB cluster is located
ALLOYDB_POSTGRES_REGION=<region>

# AlloyDB cluster name
ALLOYDB_POSTGRES_CLUSTER=<cluster>

# AlloyDB instance name within the cluster
ALLOYDB_POSTGRES_INSTANCE=<instance>

# Database user for authentication
ALLOYDB_POSTGRES_USER=<user>

# Database name to connect to
ALLOYDB_POSTGRES_DATABASE='flights_dataset'